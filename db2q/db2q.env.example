# db2q configuration - copy to ~/.db2q/db2q.env (outside your workspace) and fill in.
# Never commit the real file. Process env vars DB2Q_* and --set KEY=VALUE override these.

# --- JDBC driver -----------------------------------------------------------
DB2Q_DRIVER_JAR=/path/to/driver.jar
DB2Q_DRIVER=com.ddtek.jdbc.db2.DB2Driver
DB2Q_URL_TEMPLATE=jdbc:datadirect:db2://{host}:{port};DatabaseName={database}

# --- Database (as seen from the SSH host when tunnelling) ------------------
DB2Q_DB_HOST=db.example.internal
DB2Q_DB_PORT=50000
DB2Q_DB_NAME=MYLOCATION
DB2Q_USER=dbuser
DB2Q_PASSWORD=
DB2Q_DEFAULT_SCHEMA=MYSCHEMA

# Extra driver properties: DB2Q_PROP_<name>=<value>, passed as-is to the driver
DB2Q_PROP_currentSchema=MYSCHEMA

# --- SSH tunnel (leave DB2Q_SSH_HOST empty to connect directly) ------------
DB2Q_SSH_HOST=jump.example.internal
DB2Q_SSH_PORT=22
DB2Q_SSH_USER=sshuser
DB2Q_SSH_PASSWORD=
# DB2Q_SSH_KEY=~/.ssh/id_ed25519
# yes = only hosts already in DB2Q_SSH_KNOWN_HOSTS (default ~/.ssh/known_hosts)
DB2Q_SSH_STRICT=no

# --- Limits ------------------------------------------------------------------
DB2Q_MAX_ROWS=200
DB2Q_TIMEOUT=60
